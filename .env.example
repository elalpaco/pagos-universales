# ============================================================================
# PAGOS-UNIVERSALES — variables de entorno
# Copia este archivo a .env y ajusta los valores. Todos los valores mostrados
# son los que se usan por defecto en desarrollo (ver backend/src/config.js).
# ============================================================================

# ---------- Backend ----------

# Entorno de ejecución. En "production" JWT_SECRET y ENCRYPTION_KEY son obligatorios
# y el backend falla al arrancar si faltan.
NODE_ENV=development

# Puerto donde escucha el backend Express.
PORT=4000

# Cadena de conexión de Postgres (desarrollo). El esquema se gestiona con
# `prisma migrate` (ver backend/prisma/migrations).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pagos_universales

# Base de datos separada usada por la suite de pruebas (vitest + supertest).
# Debe existir y estar vacía; las pruebas la trunca antes de cada test.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/pagos_test

# Zona horaria de negocio (America/Bogota es UTC-5 todo el año, sin horario de verano).
TZ=America/Bogota

# Secreto para firmar los JWT de sesión (cookie httpOnly `pu_token`, 7 días).
# OBLIGATORIO en producción.
JWT_SECRET=dev-jwt-secret-change-me-0000000000

# Llave para cifrar (AES-256-GCM) los tokens de tarjeta de los proveedores de pago.
# Nunca se guarda el PAN ni el CVV, solo el token cifrado. OBLIGATORIO en producción.
ENCRYPTION_KEY=dev-encryption-key-change-me-0000

# Si el registro de nuevos usuarios está abierto (true) o cerrado (false).
ALLOW_SIGNUP=true

# Comisión del producto sobre cada cobro: porcentaje + monto fijo en COP.
FEE_PERCENT=0
FEE_FIXED_COP=0

# --- Pasarela de pagos (cobro/pull) ---
# simulated: no requiere llaves, usa tarjetas de prueba (ver docs/DISENO.md §6).
# wompi: cobro real contra la API de Wompi (Colombia).
PAYMENT_GATEWAY=simulated

# Solo si PAYMENT_GATEWAY=wompi:
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
# Opcional: sobreescribe la URL base de la API de Wompi (por defecto se deriva de WOMPI_ENV).
WOMPI_API_URL=

# --- Scheduler (motor de programación de pagos) ---
# Desactívalo en pruebas automatizadas con SCHEDULER_ENABLED=false.
SCHEDULER_ENABLED=true
SCHEDULER_CRON=*/5 * * * *

# --- Notificaciones por email (opcional) ---
# Si SMTP_HOST está vacío, solo se crean notificaciones in-app (no se envía email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PAGOS-UNIVERSALES <no-reply@pagos-universales.local>

# --- Semilla / primer usuario (admin) ---
# Se usan en `npm run seed` (y automáticamente al iniciar el contenedor Docker).
ADMIN_EMAIL=diego@pelletier.com.co
ADMIN_NAME=Diego
# Fuera de producción, si se omite, se usa "CambiaEsta123!" (se imprime una advertencia).
# En producción es OBLIGATORIO definirla explícitamente.
ADMIN_PASSWORD=CambiaEsta123!

# ---------- Frontend ----------

# URL del backend que usa Next.js para sus rewrites de /api/* (mismo origen, así la
# cookie httpOnly funciona). En docker-compose es http://backend:4000; en local,
# http://localhost:4000.
BACKEND_URL=http://localhost:4000
